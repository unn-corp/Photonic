fn ordered(v:vec4<f32>)->vec4<u32>{let canonical=select(v,vec4<f32>(0.0),v==vec4<f32>(0.0));let bits=bitcast<vec4<u32>>(canonical);return select(~bits,bits^vec4<u32>(0x80000000u),(bits&vec4<u32>(0x80000000u))==vec4<u32>(0u));}
fn restored(key:vec4<u32>)->vec4<f32>{return bitcast<vec4<f32>>(select(~key,key^vec4<u32>(0x80000000u),(key&vec4<u32>(0x80000000u))!=vec4<u32>(0u)));}
fn rank_values(xy:vec2<i32>)->RankResult{let r=i32(p.info.x);let side=u32(2*r+1);var rank=vec4<u32>(side*side/2u);var prefix=vec4<u32>(0u);var mask=0u;var anchor=vec2<i32>(0);var lower_anchor=vec2<i32>(0);var upper_anchor=vec2<i32>(0);var found_lower=false;var found_upper=false;var lo=vec4<f32>(bitcast<f32>(0x7f7fffffu));var hi=-lo;for(var dy=-r;dy<=r;dy++){for(var dx=-r;dx<=r;dx++){let v=tap(xy,dx,dy);lo=min(lo,v);hi=max(hi,v);}}if(all(lo==hi)){return RankResult(lo,vec2<i32>(0));}
 for(var step=0u;step<32u;step++){let bit=1u<<(31u-step);var counts=vec4<u32>(0u);for(var dy=-r;dy<=r;dy++){for(var dx=-r;dx<=r;dx++){let key=ordered(tap(xy,dx,dy));let matching=(key&vec4<u32>(mask))==prefix;let zero=(key&vec4<u32>(bit))==vec4<u32>(0u);if(step==31u&&matching.x){if(zero.x&&!found_lower){lower_anchor=vec2<i32>(dx,dy);found_lower=true;}if(!zero.x&&!found_upper){upper_anchor=vec2<i32>(dx,dy);found_upper=true;}}counts+=select(vec4<u32>(0u),select(vec4<u32>(0u),vec4<u32>(1u),zero),matching);}}let upper=rank>=counts;if(step==31u){anchor=select(lower_anchor,upper_anchor,upper.x);}prefix=select(prefix,prefix|vec4<u32>(bit),upper);rank=select(rank,rank-counts,upper);mask|=bit;}
 return RankResult(restored(prefix),anchor);}
