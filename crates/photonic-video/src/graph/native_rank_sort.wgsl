const CAPACITY:u32=__CAPACITY__u;
fn rank_values(xy:vec2<i32>)->RankResult{var indices:array<u32,__CAPACITY__>;var values:array<vec4<f32>,__CAPACITY__>;let sentinel=vec4<f32>(bitcast<f32>(0x7f7fffffu));for(var i=0u;i<CAPACITY;i++){values[i]=sentinel;indices[i]=i;}let r=i32(p.info.x);var count=0u;for(var dy=-r;dy<=r;dy++){for(var dx=-r;dx<=r;dx++){values[count]=tap(xy,dx,dy);count++;}}
 for(var k=2u;k<=CAPACITY;k*=2u){for(var j=k/2u;j>0u;j/=2u){for(var i=0u;i<CAPACITY;i++){let other=i^j;if(other>i){let a=values[i];let b=values[other];let lo=min(a,b);let hi=max(a,b);let low_id=select(indices[other],indices[i],a.x<=b.x);let high_id=select(indices[i],indices[other],a.x<=b.x);let ascending=(i&k)==0u;indices[i]=select(high_id,low_id,ascending);indices[other]=select(low_id,high_id,ascending);values[i]=select(hi,lo,ascending);values[other]=select(lo,hi,ascending);}}}}
 let index=indices[count/2u];let side=u32(2*r+1);return RankResult(values[count/2u],vec2<i32>(i32(index%side)-r,i32(index/side)-r));}
