@group(0) @binding(0) var source:texture_2d<f32>;
struct RankResult{values:vec4<f32>,anchor:vec2<i32>}
struct Params{info:vec4<f32>,scale:vec4<f32>,a0:vec4<f32>,a1:vec4<f32>,a2:vec4<f32>,b0:vec4<f32>,b1:vec4<f32>,b2:vec4<f32>}
@group(0) @binding(1) var<uniform> p:Params;
fn sample_at(point:vec2<f32>)->vec4<f32>{let size=vec2<i32>(p.info.zw);let q=clamp(point,vec2<f32>(0.0),vec2<f32>(size-vec2<i32>(1)));let base=vec2<i32>(floor(q));let f=fract(q);let a=textureLoad(source,base,0);if(f.x==0.0&&f.y==0.0){return a;}let hi=min(base+vec2<i32>(1),size-vec2<i32>(1));if(f.y==0.0){return mix(a,textureLoad(source,vec2<i32>(hi.x,base.y),0),f.x);}if(f.x==0.0){return mix(a,textureLoad(source,vec2<i32>(base.x,hi.y),0),f.y);}let b=textureLoad(source,vec2<i32>(hi.x,base.y),0);let c=textureLoad(source,vec2<i32>(base.x,hi.y),0);let d=textureLoad(source,hi,0);return mix(mix(a,b,f.x),mix(c,d,f.x),f.y);}
fn operand(src:vec4<f32>)->vec4<f32>{let a=clamp(src.a,0.0,1.0);var rgb=vec3<f32>(0.0);if(a>0.000001){let straight=src.rgb/a;let difference=vec2<f32>(straight.x-straight.y,straight.z-straight.y);rgb=vec3<f32>(straight.y+dot(p.a0.xz,difference),straight.y+dot(p.a1.xz,difference),straight.y+dot(p.a2.xz,difference));}return vec4<f32>(rgb,a);}
fn tap(xy:vec2<i32>,dx:i32,dy:i32)->vec4<f32>{return operand(sample_at(vec2<f32>(xy)+vec2<f32>(f32(dx),f32(dy))*p.scale.xy));}
// Reconstruct relative to an actual selected sample. This avoids cancelling
// huge basis terms when the median color is already present in the window.
fn finish_rank(result:RankResult,center:vec4<f32>,xy:vec2<i32>)->vec4<f32>{let median=result.values;var rgb=median.rgb;var alpha=median.a;let orig=operand(center);if(p.scale.z>0.5){rgb=select(orig.rgb,rgb,abs(orig.rgb-rgb)>vec3<f32>(p.info.y));alpha=orig.a;if(all(rgb==orig.rgb)){if(alpha>0.000001){return vec4<f32>(clamp(center.rgb,vec3<f32>(-65504.0),vec3<f32>(65504.0)),alpha);}return vec4<f32>(0.0,0.0,0.0,alpha);}}
 let anchor_source=sample_at(vec2<f32>(xy)+vec2<f32>(result.anchor)*p.scale.xy);let anchor=operand(anchor_source);var base=vec3<f32>(0.0);if(anchor.a>0.000001){base=anchor_source.rgb/anchor.a;}let delta=rgb-anchor.rgb;let difference=vec2<f32>(delta.x-delta.y,delta.z-delta.y);let ap1=(base+vec3<f32>(delta.y+dot(p.b0.xz,difference),delta.y+dot(p.b1.xz,difference),delta.y+dot(p.b2.xz,difference)))*alpha;return vec4<f32>(clamp(ap1,vec3<f32>(-65504.0),vec3<f32>(65504.0)),alpha);}
@fragment fn fs(@builtin(position) pos:vec4<f32>)->@location(0) vec4<f32>{if(pos.x>=p.info.z||pos.y>=p.info.w){return vec4<f32>(0.0);}let xy=vec2<i32>(pos.xy);let center=textureLoad(source,xy,0);if(p.info.x==0.0){return center;}return finish_rank(rank_values(xy),center,xy);}
